<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="1lRLzWNf1ehe5uAUcoFD">
    <mxGraphModel dx="3580" dy="1708" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor customer\n    participant bookingService\n    participant show\n    participant showSeat\n    participant priceCalculator\n    participant booking\n    participant payment\n    participant ticketPrinter\n\n    Note over customer,ticketPrinter: Customer books 1 seat and pays by UPI\n    activate customer\n    customer-&gt;&gt;bookingService: bookSeats(show, customer, A1)\n    deactivate customer\n    activate bookingService\n    alt seat does not exist\n        bookingService-&gt;&gt;show: findShowSeat A1\n        activate show\n        show--&gt;&gt;bookingService: null\n        deactivate show\n        bookingService--&gt;&gt;customer: null or failure\n        Note right of bookingService: Booking rejected no seats changed\n    else seat exists\n        bookingService-&gt;&gt;show: findShowSeat A1\n        activate show\n        show--&gt;&gt;bookingService: showSeat\n        deactivate show\n        alt seat exists but is already booked\n            bookingService-&gt;&gt;showSeat: isAvailable\n            activate showSeat\n            showSeat--&gt;&gt;bookingService: false\n            deactivate showSeat\n            Note right of showSeat: Seat remains BOOKED\n            bookingService--&gt;&gt;customer: failure\n            Note right of bookingService: Booking rejected no seats changed\n        else seat available\n            bookingService-&gt;&gt;showSeat: isAvailable\n            activate showSeat\n            showSeat--&gt;&gt;bookingService: true\n            deactivate showSeat\n            bookingService-&gt;&gt;priceCalculator: calculate selectedSeats\n            activate priceCalculator\n            priceCalculator--&gt;&gt;bookingService: amount\n            deactivate priceCalculator\n            bookingService--&gt;&gt;customer: booking\n            bookingService-&gt;&gt;booking: CREATE Booking show customer selectedSeats amount\n            activate booking\n            Note right of booking: status PENDING\n            booking--&gt;&gt;bookingService: booking\n            deactivate booking\n            customer-&gt;&gt;bookingService: provide upiId\n            bookingService-&gt;&gt;payment: CREATE UpiPayment upiId\n            activate payment\n            Note right of payment: payment is UpiPayment and type is UPI\n            deactivate payment\n            bookingService-&gt;&gt;bookingService: processPayment booking payment\n            alt invalid booking state\n                bookingService-&gt;&gt;booking: getStatus\n                activate booking\n                booking--&gt;&gt;bookingService: status\n                deactivate booking\n                Note right of bookingService: booking null or status not PENDING\n                bookingService--&gt;&gt;customer: false\n                Note right of bookingService: Payment rejected invalid booking state\n            else valid pending booking\n                bookingService-&gt;&gt;booking: getStatus\n                activate booking\n                booking--&gt;&gt;bookingService: PENDING\n                deactivate booking\n                alt payment succeeds\n                    bookingService-&gt;&gt;booking: getTotalAmount\n                    activate booking\n                    booking--&gt;&gt;bookingService: amount\n                    deactivate booking\n                    bookingService-&gt;&gt;payment: pay amount\n                    activate payment\n                    payment--&gt;&gt;bookingService: true\n                    deactivate payment\n                    Note right of payment: payment SUCCESS\n                    bookingService-&gt;&gt;showSeat: setStatus BOOKED\n                    activate showSeat\n                    showSeat--&gt;&gt;bookingService: BOOKED\n                    deactivate showSeat\n                    Note right of showSeat: State AVAILABLE to BOOKED\n                    bookingService-&gt;&gt;booking: setStatus CONFIRMED\n                    activate booking\n                    booking--&gt;&gt;bookingService: CONFIRMED\n                    deactivate booking\n                    Note right of booking: State PENDING to CONFIRMED\n                    bookingService--&gt;&gt;customer: true\n                    bookingService-&gt;&gt;bookingService: printTicket booking\n                    bookingService-&gt;&gt;ticketPrinter: print booking\n                    activate ticketPrinter\n                    ticketPrinter-&gt;&gt;booking: getBookingId\n                    activate booking\n                    booking--&gt;&gt;ticketPrinter: bookingId\n                    deactivate booking\n                    ticketPrinter-&gt;&gt;booking: getShow\n                    activate booking\n                    booking--&gt;&gt;ticketPrinter: show\n                    deactivate booking\n                    ticketPrinter-&gt;&gt;booking: getSeats\n                    activate booking\n                    booking--&gt;&gt;ticketPrinter: selectedSeats\n                    deactivate booking\n                    ticketPrinter-&gt;&gt;booking: getTotalAmount\n                    activate booking\n                    booking--&gt;&gt;ticketPrinter: amount\n                    deactivate booking\n                    ticketPrinter-&gt;&gt;booking: getStatus\n                    activate booking\n                    booking--&gt;&gt;ticketPrinter: CONFIRMED\n                    deactivate booking\n                    ticketPrinter--&gt;&gt;bookingService: Ticket printed successfully\n                    deactivate ticketPrinter\n                    Note over customer,ticketPrinter: Ticket printed successfully\n                else payment fails\n                    bookingService-&gt;&gt;booking: getTotalAmount\n                    activate booking\n                    booking--&gt;&gt;bookingService: amount\n                    deactivate booking\n                    bookingService-&gt;&gt;payment: pay amount\n                    activate payment\n                    payment--&gt;&gt;bookingService: false\n                    deactivate payment\n                    bookingService-&gt;&gt;booking: setStatus FAILED\n                    activate booking\n                    booking--&gt;&gt;bookingService: FAILED\n                    deactivate booking\n                    Note right of booking: State PENDING to FAILED\n                    Note right of showSeat: Seat remains AVAILABLE\n                    bookingService--&gt;&gt;customer: false\n                    Note right of bookingService: Payment failed booking not confirmed\n                else invalid UPI ID\n                    Note right of payment: upiId null empty or malformed\n                    bookingService-&gt;&gt;payment: pay amount\n                    activate payment\n                    payment--&gt;&gt;bookingService: false\n                    deactivate payment\n                    bookingService-&gt;&gt;booking: setStatus FAILED\n                    activate booking\n                    booking--&gt;&gt;bookingService: FAILED\n                    deactivate booking\n                    Note right of booking: State PENDING to FAILED\n                    Note right of showSeat: Seat remains AVAILABLE\n                    bookingService--&gt;&gt;customer: false\n                    Note right of bookingService: Invalid UPI ID payment failed\n                end\n            end\n        end\n    end\n    deactivate bookingService\n    Note over bookingService,payment: Payment must succeed before seat is BOOKED&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="gTmP_syJ8QtnboxFUrxM-1">
